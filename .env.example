# Google Cloud API key with "Places API" and "Distance Matrix API" enabled,
# used by the Morning Calculator's Travel mode. Restrict it to your domain(s)
# in the Google Cloud Console. See src/apps/morning-calculator/lib/googleMaps.ts.
VITE_GOOGLE_MAPS_API_KEY=

# Fine-grained GitHub PAT scoped to this repo only, with "Contents: Read and
# write" permission. Used by api/add-food-spot.ts and api/add-drink.ts to
# commit new rows to data-source/*.csv on the user's behalf. Server-side only
# — never exposed to the client. Set in Vercel project env vars.
GITHUB_TOKEN=

# Shared passcode required to use the "+ Add" forms in Food Spots and Drinks.
# The client sends it in the x-add-secret header; the API routes compare it
# against this value. Server-side only. Set in Vercel project env vars.
ADD_SECRET=
